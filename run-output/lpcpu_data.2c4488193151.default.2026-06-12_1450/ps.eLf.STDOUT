root           1       0       1  0    1 14:50   * 00:00:00 bash -c  set -e export DEBIAN_FRONTEND=noninteractive  echo "==============================================" echo "STEP 1: Install dependencies" echo "==============================================" apt-get update -qq apt-get install -y -qq \   sysstat iproute2 ethtool perl python3 bzip2 procps \   pciutils usbutils lshw dmidecode lsof numactl \   linux-tools-common linux-tools-generic 2>/dev/null  # python symlink for ndiff.py ln -sf /usr/bin/python3 /usr/bin/python  # enable sar sed -i "s/ENABLED=\"false\"/ENABLED=\"true\"/" /etc/default/sysstat 2>/dev/null || true service sysstat start 2>/dev/null || true  echo "" echo "=== Tool availability ===" for cmd in sar iostat mpstat vmstat top ss ip ethtool perl python3 bzip2 netstat ifconfig cpupower lparstat slabtop; do   printf "%-12s " "$cmd"   if which $cmd >/dev/null 2>&1; then echo "OK ($(which $cmd))"; else echo "MISSING"; fi done  echo "" echo "==============================================" echo "STEP 2: Run lpcpu (30s, all Ubuntu-compatible profilers)" echo "==============================================" cd /lpcpu chmod +x lpcpu.sh  # Generate background load during profiling ( stress-ng --cpu 1 --timeout 25 2>/dev/null || ( dd if=/dev/zero of=/dev/null bs=1M count=200 & ) ) &  ./lpcpu.sh \   duration=30 \   interval=5 \   output_dir=/lpcpu/run-output \   package_results=no \   profilers="sar iostat mpstat vmstat top meminfo interrupts" \   extra_profilers="slabtop schedstat proc_vmstat cpu_vulnerabilities" \   2>&1 | tee /lpcpu/run-output/lpcpu-run.log  DATA_DIR=$(ls -dt /lpcpu/run-output/lpcpu_data.* 2>/dev/null | head -1) echo "" echo "Data directory: $DATA_DIR" echo "File count: $(find "$DATA_DIR" -type f | wc -l)" echo "Total size: $(du -sh "$DATA_DIR" | cut -f1)"  echo "" echo "==============================================" echo "STEP 3: Inspect snapshot / profiler files" echo "==============================================" echo "--- lpcpu.out (last 25 lines) ---" tail -25 "$DATA_DIR/lpcpu.out"  echo "" echo "--- Deprecated command output ---" for f in netstat-in.before netstat-v.before netstat-s.before ifconfig.before; do   echo "[$f] $(head -1 "$DATA_DIR/$f" 2>/dev/null || echo missing)" done  echo "" echo "--- Working network snapshots ---" echo "[ip-statistics.before] $(head -1 "$DATA_DIR/ip-statistics.before")" echo "[ip-addr.STDOUT] $(head -1 "$DATA_DIR/ip-addr.STDOUT")"  echo "" echo "--- Profiler samples ---" echo "[vmstat]"; head -5 "$DATA_DIR"/vmstat.default.* 2>/dev/null echo "[mpstat]"; head -5 "$DATA_DIR"/mpstat.default.* 2>/dev/null echo "[interrupts.before IPI lines]"; grep -i IPI "$DATA_DIR/interrupts.before" 2>/dev/null | head -3 || echo "(no IPI lines)" echo "[proc-interrupts]"; head -8 "$DATA_DIR"/proc-interrupts.default.* 2>/dev/null  echo "" echo "--- System info gathered ---" ls "$DATA_DIR" | grep -E "cpuinfo|dmesg|lscpu|sysctl|summary|postprocess"   echo "" echo "==============================================" echo "STEP 4: Postprocess data" echo "==============================================" cd "$DATA_DIR" ./postprocess.sh /lpcpu 2>&1 | tee /lpcpu/run-output/postprocess.log  echo "" echo "--- Postprocess artifacts ---" ls -la summary.html chart*.html 2>/dev/null | head -20 || ls -la *.html 2>/dev/null | head -20 find . -name "chart.sh" | head -10 find . -name "*.diff" | head -15  echo "" echo "==============================================" echo "STEP 5: Diff file samples" echo "==============================================" for diff in interrupts.diff meminfo.diff ip-statistics.diff; do   if [ -f "$diff" ]; then     echo "--- $diff (first 10 lines) ---"     head -10 "$diff"     echo ""   fi done  echo "" echo "==============================================" echo "STEP 6: summary.html content" echo "==============================================" cat summary.html  echo "" echo "DONE. All artifacts in /lpcpu/run-output/" 
